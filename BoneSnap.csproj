      </Reference>
      <Reference Include="BoneLib">
        <HintPath>$(BONELAB_DIR)\Mods\BoneLib.dll</HintPath>
      </Reference>
      <Reference Include="LabFusion">
        <HintPath>$(BONELAB_DIR)\Mods\LabFusion.dll</HintPath>
      </Reference>
      <Reference Include="Il2CppInterop.Common">
