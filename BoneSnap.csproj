      <Reference Include="UnityEngine.IMGUIModule">
        <HintPath>$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\UnityEngine.IMGUIModule.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine.InputLegacyModule">
        <HintPath>$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\UnityEngine.InputLegacyModule.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine.PhysicsModule">
        <HintPath>$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\UnityEngine.PhysicsModule.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine.ScreenCaptureModule">
        <HintPath>$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\UnityEngine.ScreenCaptureModule.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine.TLSModule">
        <HintPath>$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\UnityEngine.TLSModule.dll</HintPath>
      </Reference>
      <Reference Include="Unity.TextMeshPro">
        <HintPath>$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\Unity.TextMeshPro.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine.UI">
        <HintPath>$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\UnityEngine.UI.dll</HintPath>
      </Reference>
    </ItemGroup>

    <ItemGroup>
      <None Remove="README.md" />
      <None Remove="LICENSE" />
      <None Remove=".gitignore" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Resources\Audio\*.wav" LogicalName="BoneSnap.Audio.%(Filename)%(Extension)" />
    </ItemGroup>

    <PropertyGroup>
      <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
    </PropertyGroup>

    <ItemDefinitionGroup>
      <Reference>
        <Private>false</Private>
      </Reference>
    </ItemDefinitionGroup>

    <Target Name="CheckBonelabDir" BeforeTargets="ResolveAssemblyReferences">
      <Error Condition="'$(BONELAB_DIR)' == ''" Text="BONELAB_DIR isn't set. set it to your bonelab install folder (user env var), then restart your IDE." />
      <Error Condition="'$(BONELAB_DIR)' != '' And !Exists('$(MelonNet6)\MelonLoader.dll')" Text="MelonLoader is missing from BONELAB_DIR ($(BONELAB_DIR)). check the path, or launch the game at least once." />
    </Target>

    <!-- copies the built mod into $(BONELAB_DIR)\Mods; pass -p:DeployToGame=false to skip -->
    <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
      <ItemGroup>
        <_DeployModFiles Include="$(TargetPath)" />
        <_DeployModFiles Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      </ItemGroup>
      <Warning Condition="!Exists('$(BONELAB_DIR)')" Text="skipping deploy: BONELAB_DIR ($(BONELAB_DIR)) doesn't exist." />
      <MakeDir Directories="$(BonelabModsDir)" Condition="Exists('$(BONELAB_DIR)')" />
      <!-- the dll is locked while the game is running -->
      <Copy SourceFiles="@(_DeployModFiles)" DestinationFolder="$(BonelabModsDir)" SkipUnchangedFiles="true" Retries="3" RetryDelayMilliseconds="500" ContinueOnError="WarnAndContinue" Condition="Exists('$(BONELAB_DIR)')">
        <Output TaskParameter="CopiedFiles" ItemName="_DeployedFiles" />
      </Copy>
      <Message Importance="high" Text="$(TargetName) -&gt; $(BonelabModsDir)" Condition="'@(_DeployedFiles)' != ''" />
    </Target>

    <!-- release builds copy the dll into Staging\Mods and zip Staging up for thunderstore -->
    <Target Name="PackageThunderstore" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
      <PropertyGroup>
        <_StagingDir>$(MSBuildProjectDirectory)\Staging</_StagingDir>
        <_PackageDir>$(IntermediateOutputPath)thunderstore</_PackageDir>
        <!-- point image links at github -->
        <_ReadmeAssetUrl>https://raw.githubusercontent.com/Fizzyhex/bonelab-bonesnap/main/Marketing/</_ReadmeAssetUrl>
        <_ReadmeText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\README.md').Replace('](./Marketing/', ']($(_ReadmeAssetUrl)'))</_ReadmeText>
      </PropertyGroup>
      <ItemGroup>
        <_StagingFiles Include="$(_StagingDir)\manifest.json;$(_StagingDir)\README.md;$(_StagingDir)\LICENSE.md;$(_StagingDir)\icon.png" />
      </ItemGroup>
      <!-- escaped so semicolons in the readme don't get split into separate lines -->
      <WriteLinesToFile File="$(_StagingDir)\README.md" Lines="$([MSBuild]::Escape($(_ReadmeText)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
      <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(_StagingDir)\Mods" />
      <RemoveDir Directories="$(_PackageDir)" />
      <Copy SourceFiles="@(_StagingFiles)" DestinationFolder="$(_PackageDir)" />
      <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(_PackageDir)\Mods" />
      <ZipDirectory SourceDirectory="$(_PackageDir)" DestinationFile="$(_StagingDir)\$(TargetName).zip" Overwrite="true" />
      <Message Importance="high" Text="$(TargetName) -&gt; $(_StagingDir)\$(TargetName).zip" />
    </Target>

</Project>
